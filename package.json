{
  "name": "cubrid-client",
  "version": "1.3.0",
  "description": "Modern TypeScript-first client for CUBRID.",
  "license": "MIT",
  "author": "Gyeongjun Paik <paikend@gmail.com>",
  "contributors": [
    {
      "name": "Gyeongjun Paik",
      "email": "paikend@gmail.com"
    },
    {
      "name": "Yeongseon Choe",
      "email": "yeongseon.choe@gmail.com"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "node --import tsx --test 'tests/client.test.ts' 'tests/logger.test.ts' 'tests/protocol.test.ts' 'tests/protocol-oracles.test.ts' 'tests/native-adapter.test.ts' 'tests/connection.test.ts' 'tests/concurrent-lifecycle.test.ts' 'tests/connection-tls.test.ts' 'tests/connection-string.test.ts' 'tests/query-utils.test.ts' 'tests/transaction-client-compat.test.ts' 'tests/transaction-scope.test.ts' 'tests/pool.test.ts' 'tests/destroy.test.ts' 'tests/close-lifecycle.test.ts' 'tests/schema.test.ts' 'tests/timezone.test.ts' 'tests/jdbc-parity-compare.test.ts' && node --test tests/verify-npm-version.test.mjs",
    "test:integration": "node --import tsx --test 'tests/integration.test.ts'",
    "test:all": "node --import tsx --test 'tests/*.test.ts'",
    "test:jdbc-parity": "node --import tsx tests/jdbc-parity/run.ts",
    "jdbc-parity:fetch": "node tests/jdbc-parity/fetch-jdbc.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test 'tests/client.test.ts' 'tests/logger.test.ts' 'tests/protocol.test.ts' 'tests/protocol-oracles.test.ts' 'tests/native-adapter.test.ts' 'tests/connection.test.ts' 'tests/concurrent-lifecycle.test.ts' 'tests/connection-tls.test.ts' 'tests/connection-string.test.ts' 'tests/query-utils.test.ts' 'tests/transaction-client-compat.test.ts' 'tests/transaction-scope.test.ts' 'tests/pool.test.ts' 'tests/destroy.test.ts' 'tests/close-lifecycle.test.ts' 'tests/schema.test.ts' 'tests/timezone.test.ts' 'tests/jdbc-parity-compare.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "api:check": "node scripts/api-check.mjs",
    "api:update": "npm run build && node scripts/api-check.mjs --update",
    "check": "npm run typecheck && npm run test:coverage"
  },
  "keywords": [
    "cubrid",
    "database",
    "typescript",
    "nodejs",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubrid-lab/cubrid-client.git"
  },
  "homepage": "https://github.com/cubrid-lab/cubrid-client#readme",
  "bugs": {
    "url": "https://github.com/cubrid-lab/cubrid-client/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^18.19.0",
    "c8": "^11.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
